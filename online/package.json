{
  "name": "hueco-mundo-online",
  "private": true,
  "type": "module",
  "description": "Duels Yu-Gi-Oh! en ligne avec le moteur d'EDOPro (ocgcore) et l'archétype Hueco Mundo",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/patch-ocgcore.mjs && node scripts/build-data.mjs",
    "dev": "node scripts/dev-server.mjs",
    "test": "node scripts/test-engine.mjs",
    "sync-hm": "python3 ../edopro/build_edopro.py && node scripts/pack-from-cdb.mjs ../edopro/dist/expansions/hueco-mundo.cdb packs/hueco-mundo",
    "validate": "node scripts/validate-pack.mjs",
    "postinstall": "node scripts/patch-ocgcore.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "ocgcore-wasm": "0.1.2"
  },
  "devDependencies": {
    "sql.js": "1.11.0"
  }
}
